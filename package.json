{
  "name": "shelf",
  "version": "0.1.6",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "backup:create": "node apps/api/dist/operator/cli.js backup create",
    "backup:create:dev": "node --env-file=.env.dev apps/api/dist/operator/cli.js backup create",
    "backup:restore": "node apps/api/dist/operator/cli.js backup restore",
    "backup:restore:dev": "node --env-file=.env.dev apps/api/dist/operator/cli.js backup restore",
    "build": "tsc -b packages/contracts packages/core packages/auth packages/postgres packages/storage apps/renderer apps/api apps/cli && pnpm --filter @shelf/web build",
    "check": "biome check .",
    "dev": "node apps/api/scripts/dev-runner.mjs",
    "dev:check": "node apps/api/scripts/dev-runner.mjs --check",
    "dev:database": "node --env-file=.env.dev apps/api/scripts/dev-database.mjs",
    "dev:environment": "node apps/api/scripts/dev-environment.mjs",
    "dev:setup": "pnpm dev:environment && pnpm build && pnpm dev:database && node --env-file=.env.dev apps/api/dist/operator/cli.js migrate",
    "dev:web": "pnpm --filter @shelf/web dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "renderer:dev": "node --env-file=.env.dev apps/api/dist/renderer-cli.js",
    "renderer:start": "node apps/api/dist/renderer-cli.js",
    "shelf": "node apps/cli/dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:browser": "pnpm --filter @shelf/web test:browser",
    "test:browser:install": "pnpm --filter @shelf/web test:browser:install",
    "test:runtime-e2e": "pnpm build && vitest run apps/api/test/runtime.e2e.test.ts",
    "test:streaming-memory": "pnpm --filter @shelf/api test:streaming-memory",
    "typecheck": "tsc -b packages/contracts packages/core packages/auth packages/postgres packages/storage apps/renderer apps/api apps/cli apps/web"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
