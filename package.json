{
  "name": "shelf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "tsc -b packages/contracts packages/core packages/auth packages/postgres packages/storage apps/api apps/cli",
    "check": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run --passWithNoTests",
    "test:runtime-e2e": "pnpm build && vitest run apps/api/test/runtime.e2e.test.ts",
    "test:streaming-memory": "pnpm --filter @shelf/api test:streaming-memory",
    "typecheck": "tsc -b packages/contracts packages/core packages/auth packages/postgres packages/storage apps/api apps/cli"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
