POSTGRES_DB=shelf
POSTGRES_USER=shelf
POSTGRES_PASSWORD=
SHELF_INSTALLATION_ID=installation-main
SHELF_AUTH_BASE_URL=https://shelf.example.com
SHELF_RENDERER_PUBLIC_ORIGIN=https://renderer.example.com
# Authenticated single-file upload cap in bytes (default 256 MiB, maximum 1 GiB).
SHELF_MAX_FILE_BYTES=268435456
# Content storage. Keep local for the named volume, or set r2 and fill the R2 values below.
SHELF_STORAGE_DRIVER=local
SHELF_STORAGE_LOCAL_ROOT=/var/lib/shelf/content
SHELF_R2_ACCOUNT_ID=
SHELF_R2_BUCKET=
SHELF_R2_ACCESS_KEY_ID=
SHELF_R2_SECRET_ACCESS_KEY=
SHELF_R2_SESSION_TOKEN=
SHELF_STORAGE_PREFIX=shelf
SHELF_AUTH_SECRET=
SHELF_SHARE_SIGNING_KEY=
SHELF_PRIVACY_KEY=
