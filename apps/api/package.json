{
  "name": "@shelf/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "shelf-admin": "dist/operator/cli.js",
    "shelf-renderer": "dist/renderer-cli.js",
    "shelf-server": "dist/server-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "openapi:generate": "pnpm build && node dist/generate-openapi.js && pnpm exec biome format --write openapi/v1.json",
    "test:streaming-memory": "pnpm build && node test/streaming-memory.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.2",
    "@fastify/swagger": "9.8.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "@shelf/auth": "workspace:*",
    "@shelf/contracts": "workspace:*",
    "@shelf/core": "workspace:*",
    "@shelf/postgres": "workspace:*",
    "@shelf/renderer": "workspace:*",
    "@shelf/storage": "workspace:*",
    "fastify": "5.12.1",
    "commander": "15.0.0",
    "typebox": "1.3.15"
  },
  "devDependencies": {
    "pg": "8.23.0"
  }
}
