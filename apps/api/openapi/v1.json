{
  "openapi": "3.1.0",
  "info": {
    "title": "Shelf API",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "def-0": {
        "type": "object",
        "required": [
          "apiVersion",
          "workspaceId",
          "artifactId",
          "revisionId",
          "contentHash",
          "byteCount",
          "provenance",
          "publisherMetadata",
          "requestId",
          "paths",
          "replayed"
        ],
        "properties": {
          "apiVersion": {
            "type": "string",
            "enum": ["v1"]
          },
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "artifactId": {
            "type": "string",
            "pattern": "^art_[A-Za-z0-9_-]{22}$",
            "description": "Opaque artifact identifier containing 128 bits of entropy."
          },
          "revisionId": {
            "type": "string",
            "pattern": "^rev_[A-Za-z0-9_-]{22}$",
            "description": "Opaque revision identifier containing 128 bits of entropy."
          },
          "contentHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "byteCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "provenance": {
            "type": "object",
            "required": ["classification", "observed"],
            "properties": {
              "classification": {
                "type": "string",
                "enum": ["direct-publish"]
              },
              "observed": {
                "type": "object",
                "required": ["actorId", "operation"],
                "properties": {
                  "actorId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "operation": {
                    "type": "string",
                    "enum": ["file.publish"]
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "publisherMetadata": {
            "type": "object",
            "maxProperties": 32,
            "description": "Untrusted publisher-supplied string metadata.",
            "additionalProperties": {
              "type": "string",
              "maxLength": 2048
            }
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "paths": {
            "type": "object",
            "required": ["artifact", "revision", "content"],
            "properties": {
              "artifact": {
                "type": "string",
                "pattern": "^/api/v1/artifacts/[^/]+$"
              },
              "revision": {
                "type": "string",
                "pattern": "^/api/v1/revisions/[^/]+$"
              },
              "content": {
                "type": "string",
                "pattern": "^/api/v1/revisions/[^/]+/content$"
              }
            },
            "additionalProperties": false
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "title": "PublishResult"
      },
      "def-1": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "retryable", "requestId"],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "AUTHENTICATION_REQUIRED",
                  "AUTHORIZATION_DENIED",
                  "INVALID_REQUEST",
                  "IDEMPOTENCY_CONFLICT",
                  "REVISION_NOT_FOUND",
                  "RANGE_NOT_SATISFIABLE",
                  "MULTI_RANGE_UNSUPPORTED",
                  "REQUEST_CANCELLED",
                  "CONTENT_UNAVAILABLE",
                  "SERVICE_UNAVAILABLE",
                  "INTERNAL_ERROR"
                ],
                "title": "ErrorCode"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "retryable": {
                "type": "boolean"
              },
              "requestId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["reason"],
                  "properties": {
                    "field": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "additionalProperties": false,
                  "title": "ErrorDetail"
                },
                "maxItems": 32
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "title": "ErrorEnvelope"
      },
      "def-2": {
        "type": "string",
        "enum": [
          "AUTHENTICATION_REQUIRED",
          "AUTHORIZATION_DENIED",
          "INVALID_REQUEST",
          "IDEMPOTENCY_CONFLICT",
          "REVISION_NOT_FOUND",
          "RANGE_NOT_SATISFIABLE",
          "MULTI_RANGE_UNSUPPORTED",
          "REQUEST_CANCELLED",
          "CONTENT_UNAVAILABLE",
          "SERVICE_UNAVAILABLE",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorCode"
      },
      "def-3": {
        "type": "object",
        "required": ["reason"],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "additionalProperties": false,
        "title": "ErrorDetail"
      }
    }
  },
  "paths": {
    "/api/v1/workspaces/{workspaceId}/artifacts": {
      "post": {
        "operationId": "publishFileV1",
        "summary": "Publish one immutable file revision",
        "tags": ["artifacts"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "publisherMetadata": {
                    "type": "string",
                    "description": "JSON object of string values. Must precede the file part."
                  },
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "isFile": true
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "in": "path",
            "name": "workspaceId",
            "required": true
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "in": "header",
            "name": "idempotency-key",
            "required": true
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/def-0"
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/def-1"
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/def-1"
                }
              }
            }
          },
          "403": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/def-1"
                }
              }
            }
          },
          "409": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/def-1"
                }
              }
            }
          },
          "499": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/def-1"
                }
              }
            }
          },
          "500": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/def-1"
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/def-1"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/revisions/{revisionId}/content": {
      "get": {
        "operationId": "downloadRevisionContentV1",
        "summary": "Download one exact immutable revision",
        "tags": ["revisions"],
        "description": "Returns the pinned revision as an attachment. Supports validators and one bytes range.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^rev_[A-Za-z0-9_-]{22}$"
            },
            "in": "path",
            "name": "revisionId",
            "required": true,
            "description": "Opaque revision identifier containing 128 bits of entropy."
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 256
            },
            "in": "header",
            "name": "range",
            "required": false,
            "description": "One RFC 9110 bytes range. Multiple ranges are not supported."
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 1024
            },
            "in": "header",
            "name": "if-none-match",
            "required": false,
            "description": "Conditional entity tag validator."
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Complete immutable revision bytes, always delivered as an attachment.",
            "headers": {
              "Accept-Ranges": {
                "schema": {
                  "type": "string"
                },
                "description": "Supported range unit; always bytes."
              },
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                },
                "description": "Attachment disposition with safe ASCII and RFC 5987 UTF-8 file names."
              },
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Strong SHA-256 entity tag for this revision."
              },
              "X-Content-Type-Options": {
                "schema": {
                  "type": "string"
                },
                "description": "MIME-sniffing protection; always nosniff."
              },
              "Content-Length": {
                "schema": {
                  "type": "integer"
                },
                "description": "Complete revision byte count."
              }
            },
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary",
                  "description": "Complete immutable revision bytes, always delivered as an attachment."
                }
              }
            }
          },
          "206": {
            "description": "Selected immutable revision bytes, always delivered as an attachment.",
            "headers": {
              "Accept-Ranges": {
                "schema": {
                  "type": "string"
                },
                "description": "Supported range unit; always bytes."
              },
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                },
                "description": "Attachment disposition with safe ASCII and RFC 5987 UTF-8 file names."
              },
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Strong SHA-256 entity tag for this revision."
              },
              "X-Content-Type-Options": {
                "schema": {
                  "type": "string"
                },
                "description": "MIME-sniffing protection; always nosniff."
              },
              "Content-Length": {
                "schema": {
                  "type": "integer"
                },
                "description": "Selected byte count."
              },
              "Content-Range": {
                "schema": {
                  "type": "string"
                },
                "description": "Inclusive byte range and full size."
              }
            },
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary",
                  "description": "Selected immutable revision bytes, always delivered as an attachment."
                }
              }
            }
          },
          "304": {
            "description": "The entity tag matched; no bytes are returned.",
            "headers": {
              "Accept-Ranges": {
                "schema": {
                  "type": "string"
                },
                "description": "Supported range unit; always bytes."
              },
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Strong SHA-256 entity tag for this revision."
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/def-1"
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/def-1"
                }
              }
            }
          },
          "403": {
            "description": "Default Response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/def-1"
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/def-1"
                }
              }
            }
          },
          "416": {
            "description": "Default Response",
            "headers": {
              "Content-Range": {
                "schema": {
                  "type": "string"
                },
                "description": "Unsatisfied range form: bytes */ followed by the full revision size."
              }
            },
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/def-1"
                }
              }
            }
          },
          "500": {
            "description": "Default Response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/def-1"
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/def-1"
                }
              }
            }
          }
        }
      }
    }
  }
}
